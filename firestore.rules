rules_version = '2';

// Worn Gundidj CMS — Firestore security rules (LIVE-HARDENED BASELINE)
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
//
// Works with the CURRENT app — no Cloud Functions / custom claims required.
// Posture: any signed-in staff account can use the CMS, but server-side:
//   • the audit log is append-only for EVERYONE (tamper-proof record)
//   • the roles mirror can never be written from a browser
//   • only the collections the app actually uses exist — anything else is denied
//
// The app's routine sync re-writes existing docs verbatim (full overwrite via
// batch.set), so "update allowed only when nothing changed" lets sync work
// while blocking real edits. Known trade-off: the login entry's IP backfill
// no longer replicates to the cloud copy (the original entry is preserved).
//
// NEXT STEP (findings #2/#3): per-role restriction via custom claims — see
// firestore.rules.strict and SECURITY-DEPLOY.md. Do NOT publish the strict
// file until the Cloud Functions are deployed and roles assigned.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    // Byte-identical re-write — what the app's "push everything" sync does.
    function unchanged() { return request.resource.data == resource.data; }

    // ── Core client data ────────────────────────────────────────────────────
    match /teams/{teamId}/clients/{id}       { allow read, write: if signedIn(); }
    match /teams/{teamId}/notes/{id}         { allow read, write: if signedIn(); }
    match /teams/{teamId}/timelogs/{id}      { allow read, write: if signedIn(); }
    match /teams/{teamId}/referrals/{id}     { allow read, write: if signedIn(); }

    // ── Team lists & tools ──────────────────────────────────────────────────
    match /teams/{teamId}/workersList/{id}   { allow read, write: if signedIn(); }
    match /teams/{teamId}/workflowTasks/{id} { allow read, write: if signedIn(); }
    match /teams/{teamId}/policies/{id}      { allow read, write: if signedIn(); }
    match /teams/{teamId}/chatConvs/{id}     { allow read, write: if signedIn(); }
    match /teams/{teamId}/chatMsgs/{id}      { allow read, write: if signedIn(); }

    // ── Section-access rules (who sees which pages) ─────────────────────────
    // App-level UI restricts editing to the System Manager; server-side
    // tightening to sysmanager-only comes with custom claims (strict rules).
    match /teams/{teamId}/userAccess/{id}    { allow read, write: if signedIn(); }

    // ── Staff directory (roles + display names, doc id "list") ──────────────
    // Every device reads this on sign-in to learn its own role, so a worker
    // signing in on a clean device is no longer created as a fresh "worker".
    match /teams/{teamId}/staff/{id}         { allow read, write: if signedIn(); }

    // ── Newly-synced operational stores (QA C4/H5) ─────────────────────────
    match /teams/{teamId}/fpho/{id}         { allow read, write: if signedIn(); }
    match /teams/{teamId}/walkins/{id}      { allow read, write: if signedIn(); }
    match /teams/{teamId}/calevents/{id}    { allow read, write: if signedIn(); }
    match /teams/{teamId}/resources/{id}    { allow read, write: if signedIn(); }

    // ── Audit log: append-only for EVERYONE, including admins ───────────────
    // create        → any signed-in staff (the app writes audit entries)
    // update        → only a byte-identical re-push (sync no-op); real edits denied
    // delete        → nobody, ever — "Clear audit log" only clears the local view
    match /teams/{teamId}/auditlog/{id} {
      allow read, create: if signedIn();
      allow update: if signedIn() && unchanged();
      allow delete: if false;
    }

    // ── Automatic texts (SMS Cloud Function, functions-sms/) ───────────────
    // A browser may only ASK for a text: kind (handbook / intake link) + client id
    // (+ which intake link) + its own uid. It
    // cannot supply a number or message, and cannot change a request after
    // creating it — the Cloud Function (Admin SDK) writes the result.
    match /teams/{teamId}/smsOutbox/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'clientId', 'requestedBy', 'requestedByName', 'requestedAt', 'linkId'])
        && request.resource.data.kind in ['handbook', 'intake']
        && (request.resource.data.kind == 'handbook'
            || (request.resource.data.linkId is string && request.resource.data.linkId.size() >= 16 && request.resource.data.linkId.size() <= 64))
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0 && request.resource.data.clientId.size() < 100
        && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }
    // Shared app settings, e.g. appConfig/outlook = the Azure client id for Outlook sync
    // (not a secret — it identifies the app). Set by the System Manager in Settings.
    match /teams/{teamId}/appConfig/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    // On/off switch for automatic texts (the app shows it to the System Manager only).
    match /teams/{teamId}/smsConfig/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ── Client intake forms sent by link (intake.html) ───────────────────────
    // Staff make a form for ONE client and text/email the client a link. The
    // client fills it in on their own phone WITHOUT signing in, so:
    //   • the link carries a random 128-bit id; the form's own id is
    //     SHA-256(link id + ":" + date of birth), so when a DOB is on file the
    //     link alone does not open it (the page asks for the DOB);
    //   • signed-out visitors can only GET a document whose id they already
    //     know — never list — and only before it expires;
    //   • they can change only their answers (the keys below = intake/intake-fields.js)
    //     and progress, and can mark it submitted once (with the declaration
    //     ticked). After that, or once staff cancel it, it is locked.
    // intakeLinks holds no personal details: expiry, status, whether a DOB is asked.
    match /teams/{teamId}/intakeLinks/{linkId} {
      allow get: if true;
      allow list, create, update: if signedIn();
      allow delete: if false;
    }
    match /teams/{teamId}/intakeForms/{formId} {
      allow list, create: if signedIn();
      allow get: if signedIn()
        || (resource.data.expiresAt > request.time && resource.data.status in ['open', 'draft', 'submitted']);
      allow update: if signedIn() || (
           resource.data.status in ['open', 'draft']
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'savedAt', 'submittedAt', 'step'])
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasOnly(['fullName', 'preferredName', 'dob', 'gender', 'ifLgbtiqa', 'atsi', 'mob', 'languages', 'interpreter', 'ifMarital', 'phone', 'ifSafeContact', 'email', 'address', 'ifEc1name', 'ifEc1rel', 'ifEc1phone', 'ifEc2name', 'ifEc2rel', 'ifEc2phone', 'ifHousing', 'ifEmployment', 'ifEdu', 'ifCentrelink', 'gp', 'ndis', 'ifHasChildren', 'ifPrevAccess', 'ifReferralHow', 'ifServices', 'ifAdditionalInfo', 'ifHobbies', 'ifGoalShort', 'ifGoalMedium', 'ifGoalLong', 'declaration'])
        && (request.resource.data.status == 'draft' || request.resource.data.answers.get('declaration', false) == true)
        && (!('step' in request.resource.data) || request.resource.data.step is int)
      );
      allow delete: if false;
    }
    // Monthly text spend, written only by the SMS Cloud Function (Admin SDK).
    match /teams/{teamId}/smsUsage/{month} {
      allow read: if signedIn();
      allow write: if false;
    }
    // ── 💡 Ideas for improving the CMS (the light-globe button) ─────────────
    // Anyone signed in can send one — only as themselves, only as "new", text
    // and a few labels, nothing else. Updates may touch only the review fields
    // (status / reply); the app offers them to the System Manager. Never deleted.
    match /teams/{teamId}/ideas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'category', 'page', 'submittedBy', 'submittedByName', 'submittedRole', 'createdAt', 'status'])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.page is string && request.resource.data.page.size() <= 60
        && request.resource.data.submittedByName is string && request.resource.data.submittedByName.size() <= 120
        && request.resource.data.createdAt is string;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['new', 'considering', 'planned', 'done', 'notnow']
        && (!('response' in request.resource.data) || (request.resource.data.response is string && request.resource.data.response.size() <= 1000));
      allow delete: if false;
    }

    // ── Roles mirror: written only by trusted server code (Admin SDK) ───────
    match /teams/{teamId}/roles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // No catch-all: any collection not listed above is denied by default.
  }
}
