rules_version = '2';

// Worn Gundidj CMS — Firestore security rules (LIVE-HARDENED BASELINE)
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
//
// Works with the CURRENT app — no Cloud Functions / custom claims required.
// Posture: a staff account can use the team(s) it belongs to (members/{uid} — see Teams below).
// Within a team every member can read and write (roles are applied by the app), but server-side:
//   • the audit log is append-only for EVERYONE (tamper-proof record)
//   • the roles mirror can never be written from a browser
//   • only the collections the app actually uses exist — anything else is denied
//
// The app's routine sync re-writes existing docs verbatim (full overwrite via
// batch.set), so "update allowed only when nothing changed" lets sync work
// while blocking real edits. Known trade-off: the login entry's IP backfill
// no longer replicates to the cloud copy (the original entry is preserved).
//
// NEXT STEP (findings #2/#3): per-role restriction via custom claims — see
// firestore.rules.strict and docs/SECURITY-DEPLOY.md. Do NOT publish the strict
// file until the Cloud Functions are deployed and roles assigned.

service cloud.firestore {
  match /databases/{database}/documents {

    // A real staff account. Anonymous sessions are never "signed in" here, so
    // switching Anonymous sign-in on in the Firebase console cannot open the data.
    function signedIn()  { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Byte-identical re-write — what the app's "push everything" sync does.
    function unchanged() { return request.resource.data == resource.data; }

    // ⚖️ A conflict of interest declaration (site/index.html: CONFLICT OF INTEREST). The keys and the
    // lists below match the app (the tests check).
    function validCoi(d) {
      return d.keys().hasOnly(['id', 'clientId', 'personName', 'personEmail', 'connection', 'nature', 'program', 'interest', 'declaredBy', 'declaredByEmail', 'declaredByUid', 'declaredAt', 'status', 'manage', 'managedNotes', 'reviewedBy', 'reviewedAt', 'updatedBy', 'updatedAt'])
        && d.id is string && d.id.size() <= 80
        && d.clientId is string && d.clientId.size() > 0 && d.clientId.size() <= 100
        && d.personName is string && d.personName.size() > 0 && d.personName.size() <= 120
        && d.personEmail is string && d.personEmail.matches('[^@ ]+@[^@ ]+')  && d.personEmail.size() <= 200
        && d.connection in ['family', 'friend', 'community', 'work', 'history', 'other']
        && d.nature in ['actual', 'potential', 'perceived']
        && d.get('program', '') is string && d.get('program', '').size() <= 40
        && d.interest is string && d.interest.size() > 0 && d.interest.size() <= 1000
        && d.declaredBy is string && d.declaredBy.size() <= 120
        && d.declaredByEmail is string && d.declaredByEmail.size() <= 200
        && d.declaredByUid is string && d.declaredAt is string && d.declaredAt.size() <= 40
        && d.status in ['open', 'managed', 'closed']
        && (!('manage' in d) || (d.manage is map && d.manage.keys().hasOnly(['noAllocate', 'hideFile']) && d.manage.get('noAllocate', false) is bool && d.manage.get('hideFile', false) is bool))
        && (!('managedNotes' in d) || (d.managedNotes is string && d.managedNotes.size() <= 1000))
        && (!('reviewedBy' in d) || (d.reviewedBy is string && d.reviewedBy.size() <= 200))
        && (!('reviewedAt' in d) || (d.reviewedAt is string && d.reviewedAt.size() <= 40))
        && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 200))
        && (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // ── Teams (multi-tenancy) ───────────────────────────────────────────────
    // Every team's records live under teams/{teamId}/… and a signed-in account may
    // only touch the teams it belongs to. Membership is the document members/{uid}:
    //   { teams: ['worngundidj' | 'spare' | 'test', …], email, manager?, … }
    // Team ids match site/teams.js (the tests check).
    //   • The platform owner can use every team and manages membership.
    //   • Moving in: an account that existed BEFORE teams has no membership document
    //     yet. Until the owner locks it (the document platform/lock), such an account
    //     is treated as Worn Gundidj staff — exactly what it was before — and the app
    //     records its membership the next time it signs in. It can never reach the
    //     other teams. Once platform/lock exists, no membership document = no access.
    function isOwner()   { return signedIn() && 'email' in request.auth.token && request.auth.token.email == 'jon.benson@worngundidj.org.au'; }
    function enrolled()  { return exists(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function me()        { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function wgOpen()    { return !exists(/databases/$(database)/documents/platform/lock); }
    function inTeam(t)   { return signedIn() && (isOwner() || (enrolled() ? t in me().teams : (t == 'worngundidj' && wgOpen()))); }

    // A signature sent with a client form (intake.html / consent.html): who signed, how, when,
    // and — for a drawn one — a small PNG (the keys match site/forms/signing.js SIG_KEYS).
    function validSignature(s) {
      return s is map
        && s.keys().hasOnly(['method', 'name', 'image', 'at', 'role', 'relationship', 'supportPerson'])
        && s.method in ['drawn', 'typed']
        && s.name is string && s.name.size() > 0 && s.name.size() <= 120
        && s.at is string && s.at.size() <= 40
        && s.role in ['self', 'representative']
        && (s.method == 'typed' ? !('image' in s) : (s.image is string && s.image.size() < 90000 && s.image.matches('^data:image/png;base64,.*')))
        && (s.role == 'self' ? !('relationship' in s) : (s.relationship is string && s.relationship.size() > 0 && s.relationship.size() <= 80))
        && (!('supportPerson' in s) || (s.supportPerson is string && s.supportPerson.size() <= 120));
    }

    // Who a client lets us share their information with (the consent form's "sharing" section).
    // A list can't be checked item by item in rules, so each person or service has its own fixed
    // key (pro1..pro5, per1..per5). Keys match site/consent/consent-text.js (the tests check).
    // Written lean: a request may evaluate at most 1000 expressions, and a full form (five of each) must fit.
    function validParty(m) {
      return m.keys().hasOnly(['name', 'role', 'contact', 'what', 'why', 'back'])
        && m.name.matches('.{1,120}')
        && m.get('role', '').matches('.{0,120}')
        && m.get('contact', '').matches('.{0,120}')
        && m.get('why', '').matches('.{0,300}')
        && m.what.size() > 0 && m.what.size() <= 6
        && m.what.hasOnly(['contact', 'plan', 'health', 'notes', 'referrals', 'safety'])
        && m.back in ['Yes', 'No'];
    }
    function validSharing(s) {
      return s.keys().hasOnly(['pro', 'per', 'length', 'pro1', 'pro2', 'pro3', 'pro4', 'pro5', 'per1', 'per2', 'per3', 'per4', 'per5'])
        && s.pro in ['Yes', 'No'] && s.per in ['Yes', 'No']
        && (s.pro == 'Yes' ? 'pro1' in s : !s.keys().hasAny(['pro1', 'pro2', 'pro3', 'pro4', 'pro5']))
        && (s.per == 'Yes' ? 'per1' in s : !s.keys().hasAny(['per1', 'per2', 'per3', 'per4', 'per5']))
        && ((s.pro == 'No' && s.per == 'No') ? !('length' in s) : s.length in ['m6', 'm12', 'until'])
        && (!('pro1' in s) || validParty(s.pro1)) && (!('pro2' in s) || validParty(s.pro2)) && (!('pro3' in s) || validParty(s.pro3))
        && (!('pro4' in s) || validParty(s.pro4)) && (!('pro5' in s) || validParty(s.pro5))
        && (!('per1' in s) || validParty(s.per1)) && (!('per2' in s) || validParty(s.per2)) && (!('per3' in s) || validParty(s.per3))
        && (!('per4' in s) || validParty(s.per4)) && (!('per5' in s) || validParty(s.per5));
    }
    // The consent form's own answers (keys = site/consent/consent-text.js KEYS).
    function validConsentAnswers(a) {
      return a.keys().hasOnly(['collect', 'programs', 'audit', 'video', 'transport', 'understood', 'questions', 'voluntary', 'limits', 'change'])
        && a.collect == 'Yes'
        && a.programs in ['Yes', 'No'] && a.audit in ['Yes', 'No'] && a.video in ['Yes', 'No'] && a.transport in ['Yes', 'No']
        && a.understood == true && a.questions == true && a.voluntary == true && a.limits == true && a.change == true;
    }

    // ── Core client data ────────────────────────────────────────────────────
    match /teams/{teamId}/clients/{id}       { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/notes/{id}         { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/timelogs/{id}      { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/referrals/{id}     { allow read, write: if inTeam(teamId); }

    // ── Team lists & tools ──────────────────────────────────────────────────
    match /teams/{teamId}/workersList/{id}   { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/workflowTasks/{id} { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/policies/{id}      { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/chatConvs/{id}     { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/chatMsgs/{id}      { allow read, write: if inTeam(teamId); }

    // ── Section-access rules (who sees which pages) ─────────────────────────
    // App-level UI restricts editing to the System Manager; server-side
    // tightening to sysmanager-only comes with custom claims (strict rules).
    match /teams/{teamId}/userAccess/{id}    { allow read, write: if inTeam(teamId); }

    // ── Staff directory (roles + display names, doc id "list") ──────────────
    // Every device reads this on sign-in to learn its own role, so a worker
    // signing in on a clean device is no longer created as a fresh "worker".
    match /teams/{teamId}/staff/{id}         { allow read, write: if inTeam(teamId); }

    // ── Newly-synced operational stores (QA C4/H5) ─────────────────────────
    match /teams/{teamId}/fpho/{id}         { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/walkins/{id}      { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/calevents/{id}    { allow read, write: if inTeam(teamId); }
    match /teams/{teamId}/resources/{id}    { allow read, write: if inTeam(teamId); }

    // ── Audit log: append-only for EVERYONE, including admins ───────────────
    // create        → any signed-in staff (the app writes audit entries)
    // update        → only a byte-identical re-push (sync no-op); real edits denied
    // delete        → nobody, ever — "Clear audit log" only clears the local view
    match /teams/{teamId}/auditlog/{id} {
      allow read, create: if inTeam(teamId);
      allow update: if inTeam(teamId) && unchanged();
      allow delete: if false;
    }

    // ── Automatic texts (SMS Cloud Function, functions-sms/) ───────────────
    // A browser may only ASK for a text: kind (handbook / intake link / a worker's message) + client id
    // (+ which intake link, or the words of the message) + its own uid. It
    // cannot supply a number (the function reads it from the client's file), cannot add words to a
    // handbook or intake text, and cannot change a request after
    // creating it — the Cloud Function (Admin SDK) writes the result.
    match /teams/{teamId}/smsOutbox/{id} {
      allow read: if inTeam(teamId);
      allow create: if inTeam(teamId)
        && request.resource.data.keys().hasOnly(['kind', 'clientId', 'requestedBy', 'requestedByName', 'requestedAt', 'linkId', 'body'])
        && request.resource.data.kind in ['handbook', 'intake', 'message']
        && (request.resource.data.kind == 'handbook'
            || (request.resource.data.kind == 'intake' && request.resource.data.linkId is string && request.resource.data.linkId.size() >= 16 && request.resource.data.linkId.size() <= 64)
            || (request.resource.data.kind == 'message' && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 640))
        && (request.resource.data.kind == 'message' || !('body' in request.resource.data))
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0 && request.resource.data.clientId.size() < 100
        && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }
    // Shared app settings, e.g. appConfig/outlook = the Azure client id for Outlook sync
    // (not a secret — it identifies the app). Set by the System Manager in Settings.
    match /teams/{teamId}/appConfig/{id} {
      allow read: if inTeam(teamId);
      allow write: if inTeam(teamId);
    }
    // On/off switch for automatic texts (the app shows it to the System Manager only).
    match /teams/{teamId}/smsConfig/{id} {
      allow read: if inTeam(teamId);
      allow write: if inTeam(teamId);
    }

    // ── Client intake forms sent by link (intake.html) ───────────────────────
    // Staff make a form for ONE client and text/email the client a link. The
    // client fills it in on their own phone WITHOUT signing in, so:
    //   • the link carries a random 128-bit id; the form's own id is
    //     SHA-256(link id + ":" + date of birth), so when a DOB is on file the
    //     link alone does not open it (the page asks for the DOB);
    //   • signed-out visitors can only GET a document whose id they already
    //     know — never list — and only before it expires;
    //   • they can change only their answers (the keys below = intake/intake-fields.js)
    //     and progress, and can mark it submitted once (with the declaration
    //     ticked and a signature). After that, or once staff cancel it, it is locked.
    // intakeLinks holds no personal details: expiry, status, whether a DOB is asked.
    match /teams/{teamId}/intakeLinks/{linkId} {
      allow get: if true;
      allow list, create, update: if inTeam(teamId);
      allow delete: if false;
    }
    match /teams/{teamId}/intakeForms/{formId} {
      allow list, create: if inTeam(teamId);
      allow get: if inTeam(teamId)
        || (resource.data.expiresAt > request.time && resource.data.status in ['open', 'draft', 'submitted']);
      allow update: if inTeam(teamId) || (
           resource.data.status in ['open', 'draft']
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'signature', 'status', 'savedAt', 'submittedAt', 'step'])
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasOnly(['fullName', 'preferredName', 'dob', 'gender', 'ifLgbtiqa', 'atsi', 'mob', 'languages', 'interpreter', 'ifMarital', 'phone', 'ifSafeContact', 'email', 'address', 'ifEc1name', 'ifEc1rel', 'ifEc1phone', 'ifEc2name', 'ifEc2rel', 'ifEc2phone', 'ifHousing', 'ifEmployment', 'ifEdu', 'ifCentrelink', 'gp', 'ndis', 'ifHasChildren', 'ifPrevAccess', 'ifReferralHow', 'ifServices', 'ifAdditionalInfo', 'ifHobbies', 'ifGoalShort', 'ifGoalMedium', 'ifGoalLong', 'declaration'])
        && (request.resource.data.status == 'draft' || (request.resource.data.answers.get('declaration', false) == true && validSignature(request.resource.data.signature)))
        && (request.resource.data.status == 'submitted' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signature']))
        && (!('step' in request.resource.data) || request.resource.data.step is int)
      );
      allow delete: if false;
    }

    // ── Client consent forms sent by link (consent.html) ─────────────────────
    // The same pattern as the intake forms above: staff make a form for ONE client and
    // send them a link; the client opens it WITHOUT signing in (the link id, plus their
    // date of birth when one is on file, opens one form only, until it expires), answers
    // the consent questions, says who we may share with, signs, and sends it ONCE. After that, or once staff cancel
    // it, it is locked. They cannot read or list anything else. consentLinks holds no
    // personal details. The answer keys are exactly site/consent/consent-text.js KEYS.
    match /teams/{teamId}/consentLinks/{linkId} {
      allow get: if true;
      allow list, create, update: if inTeam(teamId);
      allow delete: if false;
    }
    match /teams/{teamId}/consentForms/{formId} {
      allow list, create: if inTeam(teamId);
      allow get: if inTeam(teamId)
        || (resource.data.expiresAt > request.time && resource.data.status in ['open', 'submitted']);
      // Two writes, because a request may evaluate at most 1000 expressions and a full sharing list is most of that:
      //   1. the sharing section on its own (who we may share with) — as often as they like before sending;
      //   2. the answers and signature, ONCE, which sends the form. The sharing must already have been saved,
      //      and cannot be changed in this write.
      allow update: if inTeam(teamId) || (
           resource.data.status == 'open'
        && resource.data.expiresAt > request.time
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharing'])
            && validSharing(request.resource.data.sharing))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'signature', 'version', 'status', 'submittedAt'])
            && request.resource.data.status == 'submitted'
            && resource.data.sharing is map
            && validConsentAnswers(request.resource.data.answers)
            && validSignature(request.resource.data.signature)
            && request.resource.data.version is string && request.resource.data.version.size() <= 20
            && request.resource.data.submittedAt is string)
        )
      );
      allow delete: if false;
    }
    // Monthly text spend, written only by the SMS Cloud Function (Admin SDK).
    match /teams/{teamId}/smsUsage/{month} {
      allow read: if inTeam(teamId);
      allow write: if false;
    }
    // ── Replies from clients (Twilio → the receiveSms Cloud Function) ───────
    // Only the function creates them (Admin SDK). Staff can read them and do three things:
    // mark one as seen, dismiss one that needs nothing, or put an unmatched one on a client's file.
    // The number, the words and when it came in can never be changed or deleted.
    match /teams/{teamId}/smsInbox/{id} {
      allow read: if inTeam(teamId);
      allow update: if inTeam(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readBy', 'readAt', 'clientId', 'matchedBy', 'assignedBy', 'assignedAt'])
        && request.resource.data.status in ['new', 'read', 'dismissed']
        && request.resource.data.clientId is string && request.resource.data.clientId.size() < 100
        && (resource.data.clientId == '' || request.resource.data.clientId == resource.data.clientId)
        && request.resource.data.get('readBy', '') is string && request.resource.data.get('readBy', '').size() <= 120
        && request.resource.data.get('readAt', '') is string && request.resource.data.get('readAt', '').size() <= 40
        && request.resource.data.get('assignedBy', '') is string && request.resource.data.get('assignedBy', '').size() <= 120
        && request.resource.data.get('assignedAt', '') is string && request.resource.data.get('assignedAt', '').size() <= 40
        && request.resource.data.get('matchedBy', '') in ['', 'last-text', 'phone', 'manual'];
      allow create, delete: if false;
    }
    // Numbers that replied STOP (no texts go to them until they reply START). Written only by the function.
    match /teams/{teamId}/smsOptOut/{mobile} {
      allow read: if inTeam(teamId);
      allow write: if false;
    }
    // ── 💡 Ideas for improving the CMS (the light-globe button) ─────────────
    // Anyone signed in can send one — only as themselves, only as "new", text
    // and a few labels, nothing else. Updates may touch only the review fields
    // (status / reply); the app offers them to the System Manager. Never deleted.
    match /teams/{teamId}/ideas/{id} {
      allow read: if inTeam(teamId);
      allow create: if inTeam(teamId)
        && request.resource.data.keys().hasOnly(['text', 'category', 'page', 'submittedBy', 'submittedByName', 'submittedRole', 'createdAt', 'status'])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.page is string && request.resource.data.page.size() <= 60
        && request.resource.data.submittedByName is string && request.resource.data.submittedByName.size() <= 120
        && request.resource.data.createdAt is string;
      allow update: if inTeam(teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['new', 'considering', 'planned', 'done', 'notnow']
        && (!('response' in request.resource.data) || (request.resource.data.response is string && request.resource.data.response.size() <= 1000));
      allow delete: if false;
    }

    // ── Roles mirror: written only by trusted server code (Admin SDK) ───────
    match /teams/{teamId}/roles/{uid} {
      allow read: if inTeam(teamId);
      allow write: if false;
    }

    // ── ⚖️ Conflict of interest declarations ───────────────────────────────
    // Staff declare their own, from a client's file. The declaration itself can never be changed
    // or deleted. How it is managed (manage / notes / status) can only be changed by someone OTHER
    // than the person it is about, and the change records who made it (updatedBy = their account).
    // Declaring for yourself = status 'open' with nothing about how it is managed yet.
    // Reading: anyone in the team (the app shows the register only to the System Manager, Admins and Supervisors; the strict rules enforce it once staff roles are in the sign-in token).
    match /teams/{teamId}/coi/{id} {
      allow read: if inTeam(teamId);
      allow create: if inTeam(teamId) && validCoi(request.resource.data) && request.resource.data.id == id
        && request.resource.data.declaredByUid == request.auth.uid
        && request.resource.data.declaredByEmail == request.auth.token.get('email', '')
        && (request.resource.data.personEmail == request.auth.token.get('email', '')
              ? (request.resource.data.status == 'open' && !request.resource.data.keys().hasAny(['manage', 'managedNotes', 'reviewedBy', 'reviewedAt', 'updatedBy', 'updatedAt']))
              : true);
      allow update: if inTeam(teamId) && validCoi(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'manage', 'managedNotes', 'reviewedBy', 'reviewedAt', 'updatedBy', 'updatedAt'])
        && request.auth.token.get('email', '') != resource.data.personEmail
        && request.resource.data.updatedBy == request.auth.token.get('email', '')
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // ── Team membership ──────────────────────────────────────────────────────
    // Who may use which team. An account can read its own entry; only the owner can
    // list, change or remove entries. New entries can be made by:
    //   • the owner (any of the teams);
    //   • a team manager (manager: true, set by the owner) — for ONE of their own teams;
    //   • an account from before teams, for itself, as Worn Gundidj only, until the lock;
    //   • after the lock, an unlisted account, for itself, with NO teams (a request to be added).
    function validMember(m) {
      return m.keys().hasOnly(['teams', 'email', 'name', 'manager', 'addedBy', 'addedAt', 'updatedBy', 'updatedAt'])
        && m.teams is list && m.teams.size() <= 3 && m.teams.hasOnly(['worngundidj', 'spare', 'test'])
        && m.email is string && m.email.size() <= 200
        && (!('name' in m) || (m.name is string && m.name.size() <= 120))
        && (!('manager' in m) || m.manager is bool)
        && (!('addedBy' in m) || (m.addedBy is string && m.addedBy.size() <= 200))
        && (!('addedAt' in m) || (m.addedAt is string && m.addedAt.size() <= 40))
        && (!('updatedBy' in m) || (m.updatedBy is string && m.updatedBy.size() <= 200))
        && (!('updatedAt' in m) || (m.updatedAt is string && m.updatedAt.size() <= 40));
    }
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if signedIn() && validMember(request.resource.data) && (
           isOwner()
        || (request.auth.uid == uid && wgOpen()
            && request.resource.data.teams == ['worngundidj'] && !('manager' in request.resource.data)
            && request.resource.data.email == request.auth.token.email.lower())
        // After the lock: an account that is not listed can ask to be added. The entry gives it
        // nothing (no teams) — it only puts its email in the owner's list, to be ticked in or ignored.
        || (request.auth.uid == uid && !wgOpen()
            && request.resource.data.teams == [] && !('manager' in request.resource.data)
            && request.resource.data.email == request.auth.token.email.lower())
        || (request.auth.uid != uid && enrolled() && me().get('manager', false) == true
            && request.resource.data.teams.size() == 1 && request.resource.data.teams[0] in me().teams
            && !('manager' in request.resource.data))
      );
      allow update: if isOwner() && validMember(request.resource.data);
      allow delete: if isOwner();
    }
    // platform/lock — once it exists, accounts with no membership entry get nothing.
    match /platform/{id} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create, update: if isOwner() && id == 'lock'
        && request.resource.data.keys().hasOnly(['lockedBy', 'lockedAt'])
        && request.resource.data.lockedBy is string && request.resource.data.lockedAt is string;
      allow delete: if isOwner();
    }

    // No catch-all: any collection not listed above is denied by default.
  }
}
