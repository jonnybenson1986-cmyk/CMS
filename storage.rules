rules_version = '2';

// Worn Gundidj CMS — Cloud Storage security rules
// Deploy: Firebase Console → Storage → Rules → paste → Publish
// (or `firebase deploy --only storage` if using the CLI).
//
// Baseline posture: only signed-in staff (email/password accounts) can read or
// write team files — and only the files of a team they belong to (see inTeam below). This matches what is currently live (verified: anonymous =
// 403). Client attachments (proof of income, COA, pre-approval) and resource
// files live under teams/{teamId}/**.
//
// Hardening notes (audit findings #2/#4):
//   - A per-worker / per-role restriction requires staff roles in Firebase
//     custom claims (set by a trusted Cloud Function). See the commented target
//     block below — do NOT enable until the app writes custom claims.
//   - The size/type limits below are safe to keep enabled now: they cap uploads
//     at 25 MB and only block obviously executable content types.

service firebase.storage {
  match /b/{bucket}/o {

    // A real staff account. Anonymous sessions are never "signed in" here, so
    // switching Anonymous sign-in on in the Firebase console cannot open the data.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Teams: an account may only reach the files of a team it belongs to. Membership is the
    // Firestore document members/{uid} (see firestore.rules — the same test is used there).
    // Publishing these rules asks once for permission for Storage rules to read Firestore: say yes.
    function isOwner()  { return 'email' in request.auth.token && request.auth.token.email == 'jon.benson@worngundidj.org.au'; }
    function inTeam(t)  {
      return signedIn() && (isOwner()
        || (firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
              ? t in firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.teams
              : (t == 'worngundidj' && !firestore.exists(/databases/(default)/documents/platform/lock))));
    }
    function underLimit() { return request.resource.size < 25 * 1024 * 1024; }

    // All CMS files live under teams/{teamId}/**
    match /teams/{teamId}/{allPaths=**} {
      allow read: if inTeam(teamId);
      allow write: if inTeam(teamId) && underLimit();
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────
